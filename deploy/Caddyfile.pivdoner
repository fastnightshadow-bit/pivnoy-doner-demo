(pivdoner_app) {
  handle /api/* {
    reverse_proxy pivdoner-api:3001
  }
  handle {
    reverse_proxy pivdoner-web:8080
  }
}

# Existing Telegram-bot storefront. It stays on its original containers until
# the owner explicitly retires it after the new site has passed production QA.
pivnoy-doner.digital {
  encode gzip

  handle /api/* {
    reverse_proxy app:3001
  }

  handle {
    reverse_proxy app:3000
  }
}

pivdoner.ru, www.pivdoner.ru {
  import pivdoner_app
}

kitchen.pivdoner.ru {
  import pivdoner_app
}

courier.pivdoner.ru {
  import pivdoner_app
}

owner.pivdoner.ru {
  import pivdoner_app
}

stage.pivdoner.ru {
  handle /api/* {
    reverse_proxy pivdoner-stage-api:3001
  }
  handle {
    reverse_proxy pivdoner-stage-web:8080
  }
}
