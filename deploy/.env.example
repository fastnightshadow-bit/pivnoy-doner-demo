# Keep mock until the owner supplies YooKassa credentials out of band and
# confirms the KKT receipt setup, including the "Без НДС" tax treatment.
# Those are external launch gates; never commit real credentials here.
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
